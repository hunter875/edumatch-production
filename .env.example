# EduMatch local development environment.
# Copy this file to `.env` and replace every placeholder before running docker compose.
# Do not commit `.env`.

# Shared JWT secret used by auth, scholarship, chat, and matching services.
# Use a long random value, for example 32+ bytes from a password manager.
EDUMATCH_JWT_SECRET=replace-with-a-long-random-local-secret

# RabbitMQ local credentials.
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# MySQL local database credentials.
AUTH_DB_ROOT_PASSWORD=replace-with-auth-root-password
AUTH_DB_PASSWORD=replace-with-auth-db-password

SCHOLARSHIP_DB_ROOT_PASSWORD=replace-with-scholarship-root-password
SCHOLARSHIP_DB_PASSWORD=replace-with-scholarship-db-password

CHAT_DB_ROOT_PASSWORD=replace-with-chat-root-password
CHAT_DB_PASSWORD=replace-with-chat-db-password

# PostgreSQL local database credentials for matching-service.
# If this password contains URL-special characters, URL-encode it before using docker compose.
MATCHING_DB_PASSWORD=replace-with-matching-db-password

# Auth-service SMTP credentials.
# For local development without email delivery, use a throwaway mailbox or disabled test credentials.
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password

# Local schema behavior.
# Local/dev may keep Hibernate update for convenience. Staging/prod should use validate.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Matching-service schema behavior.
RUN_MIGRATIONS=true
AUTO_CREATE_TABLES=false

# Optional observability export.
# Local can stay empty. In Azure, set this from Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
